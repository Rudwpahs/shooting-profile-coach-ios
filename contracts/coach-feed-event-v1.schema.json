{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9]{8,64}$"
    },
    "event_class": {
      "type": "string",
      "enum": [
        "new_representative_profile",
        "retest_comparison",
        "quality_recapture_needed"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "retest_profile_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile_id",
        "retest_profile_id"
      ],
      "additionalProperties": false
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[a-z0-9]{8,64}$"
    },
    "observation_ids": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^obs_[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    },
    "primary_observation_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^obs_[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cue": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "observation_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^obs_[a-z0-9]+(?:_[a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "required": [
            "observation_id",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "medium",
        "high",
        "very_high"
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "coach_unavailable",
              "quality_recapture_needed",
              "confidence_below_medium",
              "no_visual_cue",
              "cooldown_active"
            ]
          }
        },
        "cooldown_until_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "eligible",
        "reasons",
        "cooldown_until_ms"
      ],
      "additionalProperties": false
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_class",
    "source",
    "request_id",
    "observation_ids",
    "primary_observation_id",
    "cue",
    "confidence",
    "message",
    "evidence_summary",
    "eligibility",
    "created_at_ms"
  ],
  "additionalProperties": false,
  "$id": "coach-feed-event-v1.schema.json",
  "title": "CoachFeedEventV1"
}
